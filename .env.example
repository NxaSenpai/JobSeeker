# PostgreSQL connection used by TypeORM. Auth routes are enabled when this is set.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jobseeker

FRONTEND_URL=http://localhost:5173
RESEND_API_KEY=
RESEND_FROM=JobSeeker <jobs@send.nakry-tang.me>
# Published Resend template ID or alias. The template must define:
# name, verificationUrl, and expiresIn.
RESEND_TEMPLATE_ID=
JWT_SECRET=replace-with-a-long-random-secret
PORT=3000
